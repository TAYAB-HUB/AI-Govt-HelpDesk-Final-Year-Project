APP_NAME=AI Government Helpdesk (Academic Prototype)
ENV=dev

DATABASE_URL=sqlite:///./helpdesk.db
# For docker-compose (Postgres), this is overridden to:
# DATABASE_URL=postgresql://helpdesk:helpdesk@postgres:5432/helpdesk

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-real-deployments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:19006,http://127.0.0.1:19006

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_store
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30

DEMO_DATA_DIR=../demo-data
